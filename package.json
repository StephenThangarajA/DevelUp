{
  "name": "develup-website",
  "version": "1.0.0",
  "description": "DevelUp IT Solutions - Professional website for IT business solutions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --strictPort",
    "server:start": "node server/src/index.js",
    "server:dev": "nodemon --watch server/src --ext js --exec node server/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init --create-only",
    "test": "vitest run"
  },
  "keywords": [
    "IT solutions",
    "business",
    "technology",
    "web development",
    "cloud solutions"
  ],
  "author": "DevelUp IT Solutions",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.6",
    "nodemon": "^3.1.0",
    "postcss-import": "^16.1.1",
    "prisma": "^5.20.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  },
  "overrides": {
    "quill": "^2.0.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-oauth/google": "^0.12.2",
    "@react-pdf/renderer": "^4.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.21",
    "bcrypt": "^5.1.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.5.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.544.0",
    "pdf-parse": "^2.1.1",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
